{
  "name": "ai-backoffice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI back-office with human-in-the-loop approvals via Stripe Approvals (test-mode reference implementation).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "seed": "tsx src/seed.ts",
    "status": "tsx src/status.ts",
    "webhook": "tsx src/webhook.ts",
    "propose": "tsx src/agent/propose.ts",
    "demo": "tsx src/demo.ts",
    "demo:runaway": "tsx src/runaway.ts",
    "demo:mcp": "tsx src/routes.ts",
    "demo:failed": "tsx src/failed-probe.ts",
    "demo:delivery": "tsx src/delivery/run.ts --set=delivery",
    "demo:compensate": "tsx src/delivery/run.ts --set=compensate",
    "refund-dest": "tsx src/delivery/refund-dest.ts",
    "audit": "tsx src/audit.ts",
    "reconcile": "tsx src/reconcile.ts",
    "evidence": "tsx src/evidence.ts",
    "approvals:cancel": "tsx src/cancel.ts",
    "x402:check": "tsx src/x402-check.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
