# =============================================================================
# ai_backoffice — environment configuration (TEST MODE ONLY)
# Copy to .env and fill in. NEVER commit .env. NEVER use live-mode keys.
# =============================================================================

# --- Standard test secret key ------------------------------------------------
# Used ONLY for M1 seeding (creating test customers/products/charges).
# Test key, looks like: sk_test_...
STRIPE_SECRET_KEY=

# --- Agent-tagged test key ---------------------------------------------------
# Used by the PROPOSING AGENT (M3) and the MCP route (M10) so that money-moving
# actions get intercepted by Approvals and return `approval_required`.
# Create a RESTRICTED key in Dashboard > Developers > API keys and choose
# "Authorizing agent access to your account" when asked for its intended use.
# See: https://docs.stripe.com/keys#agent-keys
# Test key, looks like: rk_test_... (secret keys cannot carry the agent tag)
STRIPE_AGENT_KEY=

# --- Webhook signing secret (M4) ---------------------------------------------
# From `stripe listen --forward-to localhost:4242/webhook`.
# Looks like: whsec_...
STRIPE_WEBHOOK_SECRET=

# --- Preview API version for v2 approval endpoints ---------------------------
# The v2 approval_request endpoints (update / list / retrieve / cancel) require
# this header. Per the "Set up two-party approvals" sample as of 2026-10-20.
# Override only if Stripe bumps the preview version.
STRIPE_PREVIEW_VERSION=2026-09-30.preview

# Which path attaches the justification: auto | update | id
#   update = POST /v2/core/approval_requests/{id}/update  (guide)
#   id     = POST /v2/core/approval_requests/{id}         (API reference)
#   auto   = try `update`, fall back to `id` on a route-level 404
STRIPE_APPROVAL_UPDATE_PATH=auto

# --- Opt-in scenario: compensate via customer balance credit (INQ-007) -------
ENABLE_BALANCE_COMPENSATION=false

# --- Stripe MCP (M10) --------------------------------------------------------
STRIPE_MCP_URL=https://mcp.stripe.com
# If the live stripe_api_write schema is not auto-mapped, set a JSON template,
# e.g. {"method":"{{method}}","path":"{{path}}","params":"{{params}}"}
STRIPE_MCP_WRITE_ARGS=

# --- Webhook server port -----------------------------------------------------
WEBHOOK_PORT=4242

# --- Refund approval threshold (JPY) -----------------------------------------
# Kept in sync with the M2 approval rule and the M1 seed data.
# The refund rule requires approval for agent-initiated refunds whose amount is
# strictly greater than this value. All refund fixtures are seeded ABOVE it, so
# every agent refund in the demo is gated; a refund at/below it would
# auto-execute (which is why the un-gated contrast case uses a metadata edit,
# not a tiny refund). Set low so "small but valid" refunds are still gated.
REFUND_APPROVAL_THRESHOLD_JPY=1000
